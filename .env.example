# Copie para .env (ou .env.local) e ajuste. Nenhum valor aqui é segredo:
# variáveis NEXT_PUBLIC_* vão para o navegador.

# URL pública da API, chamada direto pelo navegador no cardápio e no checkout.
# Local: http://localhost:8080 · Túnel: https://<api>.trycloudflare.com · Produção: URL do Render
NEXT_PUBLIC_API_URL=http://localhost:8080

# Destino do rewrite /api/* do painel (lido no servidor do Next, não vai ao navegador).
# Local: http://localhost:8080 · Produção: URL do Render
API_URL=http://localhost:8080
